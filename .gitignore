.idea/*
.DS_Store
deb/**
src/**
apt/dists/**
apt/pool/**

# Free lane (apt-free): staging, generated tree, reprepro state, markers
free/**
apt-free/dists/**
apt-free/pool/**
reprepro-free/db/**
.versions-free/
# guard: an apt tree must never live (or be committed) inside site/
site/apt/**

# The free homepage shares the main site's stylesheet, fonts, script and logos.
# sitegen/generate_free.py copies site/assets/ here so the free host can be
# previewed and deployed standalone, and bin/deploy_site.sh copies them again
# from site/assets/ at deploy time. Committing a byte-identical 1.3 MB of fonts
# and webp twice is what this line exists to avoid.
free-site/assets/**
reprepro/db/**

# Deploy script — root-privileged, VPS-only, never committed
sync_apt.sh

# Publish automation — uploaded to the VPS manually, not tracked
auto_publish.sh
systemd/

# auto_publish.sh per-package "last published tag" state (server-local)
.versions/

# SEO working files (Search Console credentials, exports, analysis)
.seo/

# Per-run list of includes reprepro rejected (generated)
.index-failures
